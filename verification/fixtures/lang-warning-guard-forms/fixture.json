{
  "id": "lang-warning-guard-forms",
  "owner_skill": "moonbit-language",
  "knowledge": "A possibly failing guard needs else or guard!, while exhaustive guards need neither a bang nor an else clause.",
  "expect": "check-fail",
  "diagnostic_contains": [
    "[E0087]",
    "guard_inexhaustive",
    "[E0088]",
    "guard_redundant_bang",
    "[E0089]",
    "guard_redundant_else"
  ],
  "fix": "Use guard ... else for handled failure, guard! for intentional termination, and plain guard for an exhaustive condition or pattern.",
  "targets": [
    "wasm-gc",
    "wasm",
    "js",
    "native"
  ],
  "moon_args": [
    "--deny-warn"
  ],
