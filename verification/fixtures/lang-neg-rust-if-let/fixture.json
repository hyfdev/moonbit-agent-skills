{
  "id": "lang-neg-rust-if-let",
  "owner_skill": "moonbit-language",
  "knowledge": "Rust's `if let Some(x) = o` is rejected; MoonBit destructures with the `is` operator: `if o is Some(x) { ... }`.",
  "habit_from": "rust",
  "expect": "check-fail",
  "diagnostic_contains": [
    "Using let statement in `if condition` directly is not allowed"
  ],
  "fix": "Write `if o is Some(x) { ... } else { ... }`",
  "targets": [
    "wasm-gc"
  ],
  "source": "observed",
