{
  "id": "lang-warning-unqualified-record",
  "owner_skill": "moonbit-language",
  "knowledge": "A struct literal bound directly by let should carry its T:: prefix; enable unqualified_record and deny warnings to enforce the current form.",
  "expect": "check-fail",
  "diagnostic_contains": [
    "[E0084]",
    "unqualified_record"
  ],
  "fix": "Write let value = T::{ ... } even when a binding annotation already identifies T.",
  "targets": [
    "wasm-gc",
    "wasm",
    "js",
    "native"
  ],
  "moon_args": [
    "--warn-list",
    "+unqualified_record",
    "--deny-warn"
  ],
  "source": "observed",
